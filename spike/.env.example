# =============================================================================
# Monad Testnet spike configuration
#
# All values in this file are for MONAD TESTNET ONLY (chain id 10143).
# The private key below is a freshly generated, DISPOSABLE TEST key with no
# value on any network. Treat it as throwaway: do not reuse for anything real.
# =============================================================================

# Monad testnet JSON-RPC (source: https://docs.monad.xyz/developer-essentials/testnet)
RPC_URL=https://testnet-rpc.monad.xyz

# Disposable testnet private key (no '0x' prefix or with prefix, either works).
PRIVATE_KEY=

# Kuru API. NOTE: Kuru's public HTTP API (https://ws.kuru.io) is MAINNET-only.
# Kuru does not document a testnet API endpoint, so this spike uses direct
# contract reads (Router/OrderBook events) for verification instead.
# KURU_API_URL=

# -----------------------------------------------------------------------------
# Task 02 / Task 05 deployed contract addresses (Monad testnet). The scripts
# default to the live Task 02 deployment (see src/config.ts); set these only
# to point at a different deployment.
# -----------------------------------------------------------------------------
# PRICE_ORACLE_ADDRESS=
# CORE_MOCKUSD_ADDRESS=
# MZNGN_TOKEN_ADDRESS=
# COLLATERAL_VAULT_ADDRESS=
# MARKET_ADDRESS=

# Task 05: set LIST_FORCE_TOPUP=1 to always demonstrate the CollateralVault
# mint path (deposit mUSD -> mint mzNGN) even when the wallet already holds
# enough mzNGN for the orders.
# LIST_FORCE_TOPUP=